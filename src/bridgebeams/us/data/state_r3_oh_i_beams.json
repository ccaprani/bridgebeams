   "locators": {
    "308.2.3.4 I-beams (shapes: AASHTO II-IV, modified Type IV, WF36-49..WF72-49 per PSID-1-13)": "PDF p235, printed 3-173",
    "Figure 308-6 (approximate maximum spans)": "PDF p236, printed 3-174",
