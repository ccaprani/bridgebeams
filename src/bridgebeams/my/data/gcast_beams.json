 "transcribed_dimensions": {
  "U": {
   "bottom_width": 970,
   "chamfer": 35,
   "outer_batter": "7 : 1 (vertical : horizontal)",
   "top": "325 = 40 (inner ledge) + 235 (raised strip) + 50 (outer ledge)",
   "vertical_steps": "30 (top to ledges), 15 (inner step), 19 (outer step)",
   "thickening": 407,
   "floor": "150 (centre) + 50 (to break) + 155 (to web toe) = 355",
   "depth_labels": "U1 800 ... U12 1600, 100 mm steps; top block slides down outer face (dashed marks)"
  },
  "TM": {
   "bottom": "970 base, 25 chamfer, 160 edge, 50 taper, 80 splay, 160 web (intermediate section; end section 320 web not implemented)",
   "top": "B = 1350-1550, flange with superelevation 'S.E.', edge callouts 39/75, splay 105 high x 220",
   "depths": "1040/1200/1360"
  },
  "I1600": "1067 top = 80 + 907 + 80; stack from top 50/77/76/102, web 838, splay 254 (254 horizontal), bottom 183 + 20 chamfer; web 203; splay 102 horizontal; base 711",
  "T1800": "1750 top with S.E.; callouts 34/75 at the tip, 94 splay (100 horizontal), 1120 web, 205 splay, 250 bottom, 20 chamfer, 660 base, 250 web"
 },
 "fitted_parameters": {
  "U": {
   "web_horizontal_width": 157.4,
   "floor_break_half_width": 265.0,
   "method": "least squares on A (%), Yb (mm/5) and Ixx (%) for 9 rows; printed dimensions fixed"
  },
  "TM": {
   "flange_thickness": 87.0,
   "method": "uniform symmetric flange fitted to the sum of the nine areas (86.95 mm unrounded); edge lean 10 mm taken from the OKA M-beam drawing because the TM bottom is the same M-type detail (convention)"
  },
  "T1800": {
   "tip_thickness": 65.0,
   "method": "fitted to A; root 131 follows the depth chain"
  }
 },
 "geometry_notes": [
  "All drawings are embedded raster images (~130-150 ppi); callouts were read from 2-4x upscaled crops.",
  "U1 (800): the 407 mm thickening would end 7 mm below the 355 mm web-toe level, so the sloping inner face is run straight to the toe (the drawn U1 dashed outline also meets the floor directly). Other marks keep the kink on the 7:1 inner web face.",
  "U: the 970 base is taken at the theoretical outer-face/soffit intersection (x = 485 + y/7), 35 x 35 chamfer. The fitted web horizontal width 157.4 mm equals the published area increment (314.2 mm2 per mm of depth / 2).",
  "TM: provenance estimate - the real flange has a crossfall and stepped edges that a symmetric profile cannot represent; A/Yb/I are nevertheless reproduced within 0.2 %/1.3 mm/0.45 %.",
  "T1800: the drawn flange has crossfall; reading 250 as the bottom flange including the 20 mm chamfer (not 250 + 20) is required for Yb to close (the alternative gives Yb 928 vs 944).",
  "I1600: dimensions are the US AASHTO Type V inch values in mm (42 x 63 in) but the top has 80 x 50 mm shoulders; it is implemented as a G-CAST profile, not as an alias of PCI Type V."
 ],
